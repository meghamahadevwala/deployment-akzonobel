global class SailfinARSSOHandler implements Auth.RegistrationHandler {

    global class RegHandlerException extends Exception {}

    global boolean canCreateUser(Auth.UserData data) {
        
        return false;
    }

    global User createUser(Id portalId, Auth.UserData data) {
        System.debug('Into createUser');
        System.debug(' portalId : ' + portalId);
        System.debug(' data : ' + data);
        
        if (data.attributeMap.containsKey('sfdc_networkid')) {
            throw new RegHandlerException('SSO Login is not supported for Experiecnce cloud in Sailfin AR App. For help, contact your administrator.');
        } else {
            List < User > users = [SELECT Id FROM User WHERE FederationIdentifier =: data.email AND IsActive=TRUE];
            if (users.size() == 1) {
                return users.get(0); // if the user is found using email, log the user in
            } else {
                throw new RegHandlerException('Cannot find the user with email ' + data.email + ' in Sailfin AR App. For help, contact your administrator.');
            }
        }
    }

    global void updateUser(Id userId, Id portalId, Auth.UserData data) {
        System.debug('Into updateUser');
        System.debug('userId : ' + userId);
        System.debug('portalId : ' + portalId);
        System.debug('data : ' + data);
        User u = new User(id = userId);
        u.FederationIdentifier = data.email;
        update(u);
    }
}