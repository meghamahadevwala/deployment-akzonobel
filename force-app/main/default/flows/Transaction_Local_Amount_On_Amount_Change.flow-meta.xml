<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>When Transaction Disputed Amount or Promised Amount changes, recalculates Dispute Amount Local and Promised Amount Local. The exchange rate is derived from the Transaction itself: Base_Amount__c (account currency) divided by Amount__c (transaction currency).</description>
    <formulas>
        <name>var_conversionRate</name>
        <dataType>Number</dataType>
        <expression>IF(
  OR(ISBLANK({!$Record.celsrm__Amount__c}), {!$Record.celsrm__Amount__c} = 0),
  1,
  {!$Record.celsrm__Base_Amount__c} / {!$Record.celsrm__Amount__c}
)</expression>
        <scale>10</scale>
    </formulas>
    <formulas>
        <name>var_disputeAmountLocal</name>
        <dataType>Number</dataType>
        <expression>ROUND({!var_conversionRate} * {!$Record.celsrm__Disputed_Amount__c}, 2)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>var_promisedAmountLocal</name>
        <dataType>Number</dataType>
        <expression>ROUND({!var_conversionRate} * {!$Record.celsrm__Promised_Amount__c}, 2)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Transaction Local Amount On Amount Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Transaction Local Amount On Amount Change</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Transaction</name>
        <label>Update Transaction</label>
        <locationX>50</locationX>
        <locationY>100</locationY>
        <inputAssignments>
            <field>celsrm__Dispute_Amount_Local__c</field>
            <value>
                <elementReference>var_disputeAmountLocal</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Promised_Amount_Local__c</field>
            <value>
                <elementReference>var_promisedAmountLocal</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Transaction</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>celsrm__Disputed_Amount__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>celsrm__Promised_Amount__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>celsrm__Transaction__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
