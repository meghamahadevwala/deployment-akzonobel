                <targetReference>Remove_Dunning_Block_Checkbox</targetReference>
            </connector>
            <label>Broken Checkbox</label>
        </rules>
        <rules>
            <name>Broken</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Grace_period__c</leftValueReference>
