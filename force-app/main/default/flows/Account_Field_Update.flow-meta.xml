<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Avoid triggering when not needed V2</description>
    <environments>Default</environments>
    <interviewLabel>Account Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Field Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Remove_Moody_details</name>
        <label>Remove Moody details</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <inputAssignments>
            <field>BvD_ID_Number__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Credit_Score_Comparison_Flag__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Moody_s_Credit_Limit__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Moody_s_Risk_Class__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Previous_Moody_s_Credit_Limit__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Previous_Moody_s_Risk_Class__c</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Remove_Moody_details</targetReference>
        </connector>
        <filterLogic>( 1 OR 3 ) AND 2 AND ( NOT 1 OR 4 OR 5)</filterLogic>
        <filters>
            <field>BvD_ID_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>celsrm__App_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Credit</stringValue>
            </value>
        </filters>
        <filters>
            <field>ParentId</field>
            <operator>NotEqualTo</operator>
        </filters>
        <filters>
            <field>Moody_s_Risk_Class__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </filters>
        <filters>
            <field>Moody_s_Credit_Limit__c</field>
            <operator>NotEqualTo</operator>
        </filters>
        <object>Account</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
