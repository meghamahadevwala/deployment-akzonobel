<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Initiate_Dispute_Approval_Process</name>
        <label>Initiate Dispute Approval Process</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <actionName>DisputeApprovalProcessInvocable</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>disputeId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>DisputeApprovalProcessInvocable</nameSegment>
    </actionCalls>
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Use_Dispute_Workflow_Matrix</name>
        <label>Use Dispute Workflow Matrix</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Disabled</defaultConnectorLabel>
        <rules>
            <name>Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaUseDisputeWorkflowMatrix</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Initiate_Dispute_Approval_Process</targetReference>
            </connector>
            <label>Enabled</label>
        </rules>
    </decisions>
    <description>Implementation-side entry point for dispute approval. Invokes DisputeApprovalProcessController when a dispute is created and workflow matrix approval is enabled.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaUseDisputeWorkflowMatrix</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  {!$Setup.celsrm__Dispute_Configuration__c.celsrm__Use_Dispute_Workflow_Matrix__c},
  {!$Setup.celsrm__Dispute_Configuration__c.celsrm__Dispute_Resolver_Type__c} = &quot;Dispute_Workflow_Matrix&quot;
)</expression>
    </formulas>
    <interviewLabel>Dispute Approval On Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Dispute Approval On Create</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Use_Dispute_Workflow_Matrix</targetReference>
        </connector>
        <object>celsrm__Dispute__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
