<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Decision_1</name>
        <label>Is Short Payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Closed_Dispute</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Decision_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payment_Reason_Code__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DSP</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.celsrm__Amount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.celsrm__Close_Date__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Dispute_Creation</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Short Payment Update</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Closed_Dispute</name>
        <label>Is Closed Dispute</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Outcome_1_of_Is_Closed_Dispute</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.celsrm__Close_Date__c</leftValueReference>
                <operator>NotEqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.celsrm__Disputed_Amount__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.celsrm__Close_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Dispute_Status</targetReference>
            </connector>
            <label>Closed Dispute</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Test Transaction-Dispute Join Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Test Transaction-Dispute Join Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Dispute_Creation</name>
        <label>Dispute Creation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Closed_Dispute</targetReference>
        </connector>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <elementReference>$Record.CurrencyIsoCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Account__c</field>
            <value>
                <elementReference>$Record.celsrm__Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Amount__c</field>
            <value>
                <elementReference>$Record.celsrm__Amount__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Dispute_Resolver__c</field>
            <value>
                <elementReference>$Record.celsrm__Account__r.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Dispute_Type__c</field>
            <value>
                <stringValue>100 Financial &amp; Invoicing</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Latest_Note_Entered_By__c</field>
            <value>
                <elementReference>$Record.celsrm__Latest_Note_Entered_By__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Latest_Note__c</field>
            <value>
                <stringValue>Auto Generated Dispute</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Reason_Code__c</field>
            <value>
                <stringValue>108 Short Payment</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Status__c</field>
            <value>
                <stringValue>10 New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>celsrm__Transaction__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>celsrm__Dispute__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_Dispute_Status</name>
        <label>Update Dispute Status to Closed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>celsrm__Status__c</field>
            <value>
                <stringValue>60 Closed</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.celsrm__Disputes__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_1</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>( 1 OR ( 2 AND 3 ))</filterLogic>
        <filters>
            <field>Payment_Reason_Code__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>DSP</stringValue>
            </value>
        </filters>
        <filters>
            <field>celsrm__Close_Date__c</field>
            <operator>NotEqualTo</operator>
        </filters>
        <filters>
            <field>celsrm__Disputed_Amount__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>celsrm__Transaction__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
