<apex:page controller="PDFAttachmentGeneratorController"
    showHeader="false"
    sidebar="false"
    applyHtmlTag="false"
    applyBodyTag="false"
    renderAs="pdf"
    contentType="application/pdf#{!fileName}.pdf"
    cache="false"
    standardStylesheets="false">
    <html>
        <head>
            <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
            <style type="text/css">
                @page {
                    size: {!statementPageSize};
                    margin: 12mm 10mm 14mm 10mm;
                    @bottom-center {
                        content: " Page : " counter(page) " of " counter(pages);
                    }
                }
                body {
                    margin: 0;
                    color: #1f2d3d;
                    font-family: Arial Unicode MS, Verdana, sans-serif;
                    font-size: 10px;
                }
                table {
                    width: 100%; 
                    border-collapse: collapse; 
                    border-spacing: 0; 
                    margin: 0; 
                }
                thead {
                    display: table-header-group;
                }
                tfoot {
                    display: table-row-group;
                }
                tr {
                    page-break-inside: avoid;
                }
                .pdf-attachment-content table.txSummaryTable {
                    -fs-table-paginate: paginate;
                    border: 1px solid #1f2d3d;
                }
                .pdf-attachment-content table.txSummaryTable thead {
                    display: table-header-group;
                }
                .pdf-attachment-content table.txSummaryTable tbody {
                    display: table-row-group;
                }
                .pdf-attachment-content table.txSummaryTable thead tr th {
                   font-weight: bold;
                   font-size: 12px;
                   background-color: black;
                   color: white;
                }
                .pdf-attachment-content table.txSummaryTable th,  
                .pdf-attachment-content table.txSummaryTable td {
                    text-align: left;
                    border: 1px solid #1f2d3d;
                    padding: 3px;
                    margin: 0; 
                    vertical-align:top; 
                }
                .pdf-attachment-content table.txSummaryTable .rightAlign {
                    text-align: right;
                }
            </style>
            <apex:outputText escape="false" value="{!attachmentStyles}" />
        </head>
        <body>
            <div class="pdf-attachment-content">
                <apex:outputText escape="false" value="{!attachmentBody}" />
            </div>
        </body>
    </html>
</apex:page>